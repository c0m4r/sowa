CONFIG_64BIT=y
CONFIG_BLK_DEV_INITRD=y
# Both release initramfs artifacts are XZ streams. Keep the decoder built into
# the kernel: there is no module filesystem available before it is unpacked.
CONFIG_RD_XZ=y
CONFIG_BINFMT_ELF=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_PACKET=y
# sshd's privilege-separated network code needs the seccomp filter; x86_64
# defconfig enables it, but the image depends on it.
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
# Landlock, the other half of what a program here can do to reduce its own
# privileges. seccomp above filters system calls; Landlock filters the
# filesystem and TCP operations a task and everything it goes on to execute may
# perform, through a ruleset the task builds for itself and can afterwards only
# narrow. Nothing has to be privileged to use it, which is the whole point: a
# program sandboxes itself rather than being wrapped in something that had to be
# root first, so it works for a user with no way to become one. The landlock
# package is the userspace side of this line - one program, landlock-sandboxer,
# compiled from samples/ in this same tarball.
#
# CONFIG_SECURITY is already on in x86_64 defconfig, for the SELinux this image
# has no policy, tools or labels for, and is named here because Landlock depends
# on it and this file is what the image's claims are checked against.
# SECURITY_NETWORK and SECURITY_PATH arrive through Kconfig selects.
#
# CONFIG_LSM is the ordered list the kernel initialises, and a module left out
# of it is compiled in and never enabled: the system calls then answer
# EOPNOTSUPP rather than ENOSYS, which is a different failure with the same
# result. Landlock is already first in upstream's default string, so this value
# is that default written out rather than a change to it - written out because a
# defconfig or a Kconfig default that stopped naming landlock would otherwise
# produce a kernel that fails no check here and cannot sandbox anything. "lsm="
# on the kernel command line overrides it at boot.
CONFIG_SECURITY=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,selinux,smack,tomoyo,apparmor,ipe,bpf"
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
# The two VPNs, which are kernel features before they are packages.
#
# TUN is the /dev/net/tun character device OpenVPN reads and writes its tunnel
# through: the daemon is entirely userspace, but without this it has no
# interface to attach to and exits at startup. It is also what any other
# userspace tunnel in the repository would want.
#
# WIREGUARD is the whole of WireGuard. Unlike OpenVPN there is no daemon - the
# tunnel is a network device the kernel drives, and the wireguard-tools package
# only configures it over netlink - so an image whose kernel lacks this has
# tools that can do nothing at all. It pulls in its own cryptography through
# Kconfig selects, so nothing else has to be asked for by name.
CONFIG_TUN=y
CONFIG_WIREGUARD=y
# The packet filter the iptables package configures. Sowa ships iptables-legacy
# rather than iptables-nft, so the legacy setsockopt interface - split out of
# NETFILTER_XTABLES in 6.15 - has to be built in; without it every command fails
# with "Table does not exist". x86_64 defconfig already provides conntrack, NAT,
# masquerade and the LOG target, but as modules this kernel cannot load, and the
# tables themselves default to modules too, so each one is asked for by name.
# NETFILTER_ADVANCED is what makes the ordinary matches selectable at all.
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_NETFILTER_XT_NAT=y
# The default firewall uses conntrack state. In Linux 6.18 the TCP, UDP, IPv4
# ICMP and IPv6 ICMP matches are compiled as part of NETFILTER_XTABLES itself;
# conntrack remains a separate tristate and must be built in explicitly because
# this image has no modules.
CONFIG_NF_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
# MASQUERADE, which the comment above says is asked for by name and was not.
# Neither IP_NF_NAT nor IP6_NF_NAT selects it - they select NETFILTER_XT_NAT,
# which is SNAT and DNAT only - so until now it has been arriving from
# defconfig alone, unasserted. Docker's POSTROUTING rule for the bridge
# network is a MASQUERADE, in both families, and so is wg-quick's.
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
# The IPv6 nat table: the twin of CONFIG_IP_NF_NAT above, which IPv6 never got.
# dockerd has defaulted to --ip6tables=true since 28, and the first thing it
# does with the bridge network is "ip6tables -t nat -N DOCKER". Without this
# the kernel answers "Table does not exist (do you need to insmod?)", and every
# daemon start logs "ip6tables is enabled, but cannot set up ip6tables chains"
# before carrying on with IPv4 only.
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_REJECT=y
# The rest of the packet filter is here for one program: wg-quick(8). A peer
# with 0.0.0.0/0 or ::/0 in AllowedIPs is routed through a table of its own,
# selected by firewall mark, and wg-quick installs the rules that make that
# routing safe - a prerouting drop for packets that arrive claiming the
# tunnel's own address, and the connection-mark save and restore that keeps a
# reply leaving through the interface its request arrived on. Upstream writes
# those with nft where it finds it and with iptables where it does not; Sowa
# ships iptables-legacy, so it is the second path that has to work. The raw
# table is where the prerouting drop goes, and addrtype, mark and CONNMARK are
# the three extensions those rules name. Without them "wg-quick up" fails part
# way through, having already created the interface.
CONFIG_IP_NF_RAW=y
CONFIG_IP6_NF_RAW=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_TARGET_CONNMARK=y
# Policy routing for IPv6. x86_64 defconfig enables the IPv4 half
# (CONFIG_IP_MULTIPLE_TABLES) and leaves this one off, and without it the kernel
# answers every RTM_GETRULE for AF_INET6 with EAFNOSUPPORT: "ip -6 rule show"
# fails with "Address family not supported by protocol", and so does anything
# that reads the machine's routing state before changing it - which is what nic
# does to capture the baseline it rolls back to.
CONFIG_IPV6_MULTIPLE_TABLES=y
# What guix-daemon builds in. A Guix build runs as one of the guixbuild
# accounts, in a chroot, with mount, IPC, UTS, PID and network namespaces of its
# own - that isolation is the whole reason a store path can be said to name its
# contents. x86_64 defconfig enables all five, but the guix package depends on
# them, so they are asked for by name here rather than inherited.
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
# The one defconfig leaves off. The daemon itself does not need it - it runs as
# root and drops to the build users - but "guix shell --container", relocatable
# "guix pack" binaries, and any unprivileged use of the store do. It is enabled
# knowing what it is: unprivileged user namespaces are a standing source of
# kernel privilege escalations, and a machine that will never run Guix loses
# nothing by taking this line out and rebuilding.
CONFIG_USER_NS=y
# Docker needs the unified hierarchy mounted at boot as well as these kernel
# capabilities behind it. Cgroups and the device controller come from x86_64
# defconfig, but are named here because Docker depends on them. runc installs
# device rules as cgroup-attached eBPF programs on cgroup v2, which makes the
# bpf(2) syscall an intentional attack-surface trade-off alongside USER_NS:
# systems that will never run containers can remove this whole block and
# rebuild. The bridge and veth form Docker's default docker0 network; bridge
# netfilter makes its forwarded packets visible to the iptables rules Docker
# installs. Overlayfs is the overlay2 storage driver, and the remaining two
# controllers implement Docker's --memory and --cpus limits. Modules are off,
# so every tristate must be built in.
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_VETH=y
CONFIG_OVERLAY_FS=y
CONFIG_MEMCG=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y
# FUSE is the kernel side of user-space filesystems such as sshfs and many
# application bundle runtimes. SquashFS is the read-only image format used by
# AppImage and other packaged filesystem images; support every upstream
# compression format so an image does not become unusable based on its creator's
# compressor choice. These are built in because this kernel deliberately has no
# module loader.
#
# SquashFS is also, since the live medium stopped being one enormous initramfs,
# how this kernel gets a root filesystem at all: /sowa/x86_64/root.sfs on the
# medium, attached to a loop device and mounted read-only by liveinit. It is
# the one entry in this file the boot cannot start without.
CONFIG_FUSE_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_LZO=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
# The rest of the live medium's root filesystem, in the order liveinit uses it.
#
# ISO9660 is the medium itself, whether it was burned to a disc or written to a
# USB stick with dd; Joliet and Rock Ridge are how the names on it survive.
# BLK_DEV_LOOP is what turns the squashfs file into a block device to mount -
# and what mounts the ISO itself when GRUB's loopback.cfg boots the image from
# a file. OVERLAY_FS is above with the container options, because Docker's
# overlay2 driver asked for it first; the live root is an overlay too, a tmpfs
# over the read-only squashfs, and that is now the more fundamental of the two
# uses.
#
# TMPFS_XATTR is the non-obvious one. Overlayfs records which files have been
# deleted from its lower layer in trusted.overlay.* extended attributes on the
# upper one, so a tmpfs built without xattr support cannot be an upperdir at
# all: the mount fails outright, and the live system has no root filesystem.
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_ZISOFS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_TMPFS_XATTR=y
# Compressed swap in memory, which is the live medium's answer to having no
# disk to swap to. zram is a block device that keeps what is written to it
# compressed in RAM; /etc/rc.d/init.d/zram makes one and swaps on it, so cold
# anonymous pages cost about a third of the room they did instead of nothing
# being able to reclaim them at all. The live root is a tmpfs over the
# squashfs and tmpfs pages are swappable, so this is what lets a boot on a
# small machine keep writing after the root has taken the memory. SWAP is
# already on in x86_64 defconfig and is named here because everything below
# needs it.
#
# The recovery initramfs runs the same service and gets less out of it: its
# tree is the ramfs the kernel unpacked into, and ramfs pages cannot be swapped
# out at all, so the memory the root filesystem is holding stays held. What is
# left is the ordinary case - the anonymous memory of whatever is running -
# which is worth having and is not the reason this is here.
#
# ZSMALLOC, the allocator zram stores compressed pages in, arrives through a
# Kconfig select. Two backends are built. zstd is the default because the
# thing it is being compared against is a disk that is not there, so the
# better ratio is worth the cycles; lzo-rle is kept because it is the kernel's
# own default and the name every other piece of documentation uses, and it
# costs nothing here - LZO_COMPRESS is already in the build. Modules are off,
# so each of these is a tristate that has to be y, and the default compressor
# is a choice whose other arm is turned off by name so that this file says
# which one won.
CONFIG_SWAP=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_LZO=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
# CONFIG_ZRAM_DEF_COMP_LZORLE is not set
# The storage stack a from-RAM boot never needed. The old image was handed its
# entire root filesystem by the boot loader and could reach a login prompt on a
# machine whose disks it could not see at all; this one has to find the medium
# it came from, which means every controller a Sowa medium could be plugged
# into has to be built in. Modules are off, so each of these is a tristate that
# has to be y.
#
# SCSI and its disk and CD-ROM drivers are the common layer: USB mass storage,
# SATA and the optical drive all present themselves through it. ATA covers the
# SATA controllers - AHCI for anything modern, PIIX for the IDE emulation QEMU
# and older firmware provide - and NVMe covers the rest. The USB half needs
# both the controller drivers (xHCI for USB 3, EHCI/OHCI/UHCI for what is still
# in older machines) and the two mass-storage protocols: usb-storage for
# ordinary sticks and UAS for the ones that speak SCSI directly. MMC is the
# card reader an installed-to-SD-card machine boots from.
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=y
CONFIG_SCSI_VIRTIO=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=y
CONFIG_BLK_DEV_NVME=y
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PCI=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
# Filesystems offered by sowa-setup.  All three have to be built in because an
# installed system boots its root directly, without an initramfs from which a
# filesystem module could be loaded.
CONFIG_EXT4_FS=y
CONFIG_XFS_FS=y
CONFIG_XFS_QUOTA=y
CONFIG_XFS_POSIX_ACL=y
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
# Linux software RAID and device mapper, the kernel halves of mdadm and LVM2.
# Common RAID levels and the LVM targets useful on a general-purpose server are
# built in; arrays and volume groups used for non-root filesystems are assembled
# by rc.sysinit before it processes /etc/fstab.
CONFIG_MD=y
CONFIG_BLK_DEV_MD=y
CONFIG_MD_LINEAR=y
CONFIG_MD_RAID0=y
CONFIG_MD_RAID1=y
CONFIG_MD_RAID10=y
CONFIG_MD_RAID456=y
#
# Only the device-mapper targets the shipped userspace can actually drive are
# built in. Thin provisioning and dm-cache are left out because LVM2 is
# configured --with-thin=none --with-cache=none and their metadata tools are a
# separate upstream project Sowa does not package: a kernel that offered them
# while lvcreate refused them would be a claim the system cannot honour.
# dm-multipath needs multipath-tools, dm-flakey is a fault-injection target for
# testing, and neither is here for the same reason.
CONFIG_BLK_DEV_DM=y
CONFIG_DM_SNAPSHOT=y
CONFIG_DM_WRITECACHE=y
CONFIG_DM_MIRROR=y
CONFIG_DM_RAID=y
CONFIG_DM_ZERO=y
CONFIG_DM_UEVENT=y
CONFIG_DM_INTEGRITY=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
# The framebuffer console, which is what draws the boot logo above the kernel
# log: one penguin per online CPU. CONFIG_LOGO needs FB_CORE, which the DRM
# fbdev emulation selects, and fbcon needs a KMS driver to attach to. simpledrm
# takes over the framebuffer the firmware left behind (EFI GOP or VESA), which
# covers real hardware whose native driver is not built in, and bochs covers
# QEMU's default stdvga; virtio-gpu is already in defconfig. Only the 224-color
# logo is kept - the mono and 16-color variants only apply to 1bpp and 4bpp
# framebuffers no target here has.
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_BOCHS=y
CONFIG_LOGO=y
CONFIG_LOGO_LINUX_CLUT224=y
# CONFIG_LOGO_LINUX_MONO is not set
# CONFIG_LOGO_LINUX_VGA16 is not set
CONFIG_PRINTK=y
CONFIG_EARLY_PRINTK=y
CONFIG_DEBUG_INFO_NONE=y
# x86_64 defconfig turns on the stack-usage instrumentation, which poisons each
# new kernel stack and rescans it at every task exit, printing "used greatest
# stack depth" whenever a task sets a new high-water mark. That is a kernel
# developer's tool, not something a booted image should be logging at pr_info
# over the console, and ordinary programs keep re-triggering it as they run.
# CONFIG_DEBUG_STACK_USAGE is not set
CONFIG_MODULES=n
